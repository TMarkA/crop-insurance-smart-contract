# Copy this file to .env and fill in your own values. Never commit .env.
GANACHE_URL=http://127.0.0.1:7545
# Ganache GUI uses chain ID 1337 (network ID 5777)
CHAIN_ID=1337
CONTRACT_ADDRESS=0xYourDeployedContractAddress
# Farmer wallet: must be the address the policy was created for
WALLET_ADDRESS=0xYourFarmerWalletAddress
PRIVATE_KEY=0xYourFarmerWalletPrivateKey
# Seconds between submissions; must be >= the policy's submissionInterval
SUBMIT_INTERVAL_SEC=60
